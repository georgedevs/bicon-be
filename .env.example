# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# The password used to obtain a JWT. Minimum 16 characters.
ADMIN_SECRET=change-me-minimum-16-chars

# ─── Database ─────────────────────────────────────────────────────────────────
# Local (docker-compose): mongodb://localhost:27017/bicon
# Atlas free tier: mongodb+srv://<user>:<pass>@cluster.mongodb.net/bicon
MONGO_URI=mongodb://localhost:27017/bicon

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local (docker-compose): redis://localhost:6379
# Upstash free tier: rediss://<user>:<pass>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Nokia Network as Code ────────────────────────────────────────────────────
# Obtain from: https://developer.nokia.com/network-as-code
NOKIA_API_KEY=
# Used to verify HMAC-SHA256 signatures on Nokia webhook calls
NOKIA_WEBHOOK_SECRET=

# ─── Africa's Talking ─────────────────────────────────────────────────────────
# Sandbox credentials from: https://account.africastalking.com/
AT_API_KEY=
AT_USERNAME=sandbox

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all.
ALLOWED_ORIGINS=http://localhost:3001
