# ── REQUIRED — app will refuse to start without these ─────────────────────────

JWT_SECRET=change-me-to-a-long-random-string-minimum-32-chars
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/bicon?retryWrites=true&w=majority
REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:6379
ADMIN_SECRET=change-me-minimum-16-chars

# ── APP ────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
API_PREFIX=api
JWT_EXPIRES_IN=24h

# ── NOKIA CAMARA ───────────────────────────────────────────────────────────────

NOKIA_API_KEY=
NOKIA_WEBHOOK_SECRET=
NOKIA_WEBHOOK_BASE_URL=https://bicon-be.fly.dev
NOKIA_MCP_SERVER_URL=

# ── PIPELINE ───────────────────────────────────────────────────────────────────

# v1 = parallel CAMARA scoring  |  v2 = Claude agentic via MCP
PIPELINE_VERSION=v1

# ── AFRICA'S TALKING (USSD) ────────────────────────────────────────────────────

AT_API_KEY=
AT_USERNAME=sandbox

# ── AI TRIAGE — OpenRouter → Claude ───────────────────────────────────────────

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ── CONGESTION POLLING ─────────────────────────────────────────────────────────

CONGESTION_POLL_INTERVAL_MS=60000
CAMARA_TEST_PHONE=+99999991000

# ── RATE LIMITING ──────────────────────────────────────────────────────────────

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
